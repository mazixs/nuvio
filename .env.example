# Nuvio settings template.
# Copy this file to .secrets/.env and fill in the required values:
#   mkdir -p .secrets
#   cp .env.example .secrets/.env
#
# Use the same file with Compose:
#   docker compose --env-file .secrets/.env up -d

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Bot token from @BotFather.
TELEGRAM_TOKEN=

# Comma-separated administrator IDs. @userinfobot can show your ID.
ADMIN_IDS=

# Telegram application credentials for the local Bot API.
# Create them at https://my.telegram.org under API development tools.
# These are not a bot token or personal account credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# =============================================================================
# WEB UI
# =============================================================================

WEB_USERNAME=admin
WEB_PASSWORD=changeme

# Stable session signing key; at least 32 random bytes are recommended.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=
WEB_PORT=8080

FAIL2BAN_RETRIES=5
FAIL2BAN_TIME=10m

# =============================================================================
# DOWNLOADS AND PROCESSING
# =============================================================================

LOG_LEVEL=INFO
DOWNLOAD_WORKERS=8
BLOCKING_TASK_TIMEOUT=600

# TikTok fast path: fetch a direct H.264 URL with audio instead of using yt-dlp.
# It avoids HEVC transcoding (up to 9.5 s for a one-minute clip), but delivers
# 576x1024 rather than 1080p. If URL resolution fails, it falls back to yt-dlp.
#
# Changing this flag does not affect already cached URLs. The file_id cache
# is checked before downloading and lasts 90 days. After setting
# TIKTOK_FAST_PATH=false, previously processed URLs still deliver 576x1024.
# /cleanup_cache removes only entries older than 90 days. To reset cached
# quality immediately, remove telegram_cache.db from DATA_DIR or send a URL
# that has not been cached yet.
TIKTOK_FAST_PATH=true

# Instagram fast path: fetch the direct GraphQL URL instead of using yt-dlp.
# Instagram supplies H.264 + AAC, so quality is unchanged. In measurements,
# download took about 1.9 s instead of 7.5 s. GraphQL failures fall back to
# yt-dlp. Audio extraction also benefits from the already downloaded video.
INSTAGRAM_FAST_PATH=true

# yt-dlp is pinned in the image. Update it through scripts/update_ytdlp.py,
# CI, and a new image.
YTDLP_CLI_FALLBACK=true
YTDLP_CLI_TIMEOUT=900

# YouTube canary: every CANARY_INTERVAL_HOURS, the bot downloads a control
# video through the same path as a user download, bypassing the file_id cache.
# A failure alerts administrators. It is disabled by default because it adds
# YouTube requests from the server address; enable it deliberately.
#
# CANARY_VIDEO_ID should be longer than a few minutes. The failure observed
# on 2026-08-18 appeared only after about a minute of media, so a short clip
# would have passed while full downloads were broken. The default is Big Buck
# Bunny (10 minutes, Creative Commons, no regional restrictions).
CANARY_ENABLED=false
CANARY_INTERVAL_HOURS=12
CANARY_VIDEO_ID=6WFj-CKldv4

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Published Nuvio image tag for compose.yaml.
TAG=latest

# Paths inside the container. Usually no changes are needed.
YOUTUBE_COOKIES_FILE=/app/.secrets/www.youtube.com_cookies.txt
INSTAGRAM_COOKIES_FILE=/app/.secrets/www.instagram.com_cookies.txt
TIKTOK_COOKIES_FILE=/app/.secrets/www.tiktok.com_cookies.txt

# TELEGRAM_LOCAL_MODE, the local Bot API address, TEMP_DIR, and the file size
# limit are set in compose.yaml so containers use the same shared volume.
