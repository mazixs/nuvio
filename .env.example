# Nuvio settings template.
# Copy this file to .secrets/.env and fill in the required values:
#   mkdir -p .secrets
#   cp .env.example .secrets/.env
#
# Use the same file with Compose:
#   docker compose --env-file .secrets/.env up -d
#
# A commented-out setting shows its default. Uncomment only what you change.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Bot token from @BotFather.
TELEGRAM_TOKEN=

# Comma-separated administrator IDs. @userinfobot can show your ID.
ADMIN_IDS=

# Telegram application credentials for the local Bot API.
# Create them at https://my.telegram.org under API development tools.
# These are not a bot token or personal account credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# =============================================================================
# WEB UI
# =============================================================================

# Sign-in stays closed until you set a password.
WEB_PASSWORD=
# WEB_USERNAME=admin

# Session signing key of at least 32 random characters. Without it, or with a
# shorter one, a random key is generated at every start and everyone has to sign
# in again. Generate a stable one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WEB_SECRET_KEY=

# WEB_PORT=8080
# FAIL2BAN_RETRIES=5
# FAIL2BAN_TIME=10m

# =============================================================================
# HTTP API
# =============================================================================

# Download API for external clients; keys are issued on the WebUI "API keys"
# page. Compose starts it only with the api profile: add COMPOSE_PROFILES=api to
# this file or pass --profile api. Publish it through an HTTPS reverse proxy; see
# docs/guides/api.md.
# API_PORT=8090
# Concurrent downloads across all keys, separate from the bot's pool.
# API_DOWNLOAD_WORKERS=4
# Downloads that one key may have queued or running at once.
# API_MAX_ACTIVE_JOBS=2
# Requests per key per minute, status polling included.
# API_RATE_LIMIT_PER_MINUTE=120
# Minutes a finished file stays available for download (5-1440).
# API_RESULT_TTL_MINUTES=60
# Largest file the API downloads, in MB (1-2000). It does not depend on the
# bot's Telegram mode: the API serves files itself.
# API_MAX_FILE_SIZE_MB=2000
# Disk space for finished files of all keys together, in MB. Above it, the
# oldest results expire early. Running downloads come on top of it.
# API_STORAGE_LIMIT_MB=10000

# =============================================================================
# DOWNLOADS AND PROCESSING
# =============================================================================

# LOG_LEVEL=INFO
# DOWNLOAD_WORKERS=8
# BLOCKING_TASK_TIMEOUT=600

# TikTok fast path: fetch a direct H.264 URL with audio instead of using yt-dlp.
# It avoids HEVC transcoding, but delivers 576x1024 rather than 1080p. If URL
# resolution fails, it falls back to yt-dlp.
#
# This flag is part of the artifact cache recipe; changing it uses a different
# cached output. Valid Telegram references have no expiration by default.
# Optional idle-age cleanup is managed in the WebUI; /cleanup_cache applies the
# same policy.
# TIKTOK_FAST_PATH=true

# Instagram fast path: fetch the direct GraphQL URL instead of using yt-dlp.
# Quality is unchanged. GraphQL failures fall back to yt-dlp.
# INSTAGRAM_FAST_PATH=true

# yt-dlp is pinned in the image. Update it through scripts/update_ytdlp.py,
# CI, and a new image.
# YTDLP_CLI_FALLBACK=true
# YTDLP_CLI_TIMEOUT=900

# YouTube canary: every CANARY_INTERVAL_HOURS, the bot downloads a control
# video through the same path as a user download, bypassing the file_id cache.
# A failure alerts administrators. It is disabled by default because it adds
# YouTube requests from the server address.
#
# CANARY_VIDEO_ID should be longer than two minutes. The failure observed
# on 2026-08-18 appeared only after about a minute of media, so a short clip
# would have passed while full downloads were broken.
# CANARY_ENABLED=false
# CANARY_INTERVAL_HOURS=12
# CANARY_VIDEO_ID=6WFj-CKldv4

# =============================================================================
# COMPOSE
# =============================================================================

# Published Nuvio image tag.
# TAG=latest
# Path to this file for the containers, if it is not .secrets/.env.
# NUVIO_ENV_FILE=.secrets/.env

# TELEGRAM_LOCAL_MODE, the local Bot API address, and TEMP_DIR are set in
# compose.yaml so containers use the same shared volume.
